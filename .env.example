# Spotafriend settings
#
# Copy this file to .env (same folder) and fill in what you need:
#     cp .env.example .env
# .env is gitignored, so real values never reach GitHub. This example file is
# committed, so never put real keys, IDs or passwords in it.
#
# Every setting is optional; the defaults run the demo with no setup.
# A value typed in the terminal (e.g. SPOTAFRIEND_EMAIL_ALERTS=log ./manage.py ...)
# wins over this file.


# ---- Email alerts (AWS SNS) ------------------------------------------------
# Emails people about new messages and chat requests while they're away.
#   off  no email alerts (default)
#   log  print the emails that would be sent, without contacting AWS
#   sns  really send them through AWS SNS
SPOTAFRIEND_EMAIL_ALERTS=off

# The SNS topic to send through (its ARN), when a teammate created one for us.
# Looks like: arn:aws:sns:us-east-1:123456789012:spotafriend-alerts
# Leave empty to use (or create) a topic named SPOTAFRIEND_SNS_TOPIC in the
# AWS account you're logged in to.
SPOTAFRIEND_SNS_TOPIC_ARN=
SPOTAFRIEND_SNS_TOPIC=spotafriend-alerts

# AWS region. Optional: if empty, it's taken from the topic ARN above, then
# from your AWS config (~/.aws/config).
AWS_REGION=

# AWS login keys are NOT set here. They come from `aws configure`
# (stored in ~/.aws/credentials, outside this project).

# Seconds without the page checking in before someone counts as "away".
SPOTAFRIEND_AWAY_SECONDS=60

# Link included in alert emails.
SPOTAFRIEND_SITE_URL=http://localhost:8000


# ---- Made-up listeners ------------------------------------------------------
# on (default): the demo friend and other seeded listeners can match you.
# off: only people who really imported a playlist can match each other.
SPOTAFRIEND_FAKE_USERS=on

# ---- Live chat (AWS AppSync Events) ----------------------------------------
# "Start chat" on a match sends "<name> wants to chat with you" to every open
# page and opens /chat/, where two people talk live over a WebSocket.
# Fill these in with the lines that `python manage.py appsync_setup` prints.
# Off while empty. The API key is handed to the browser, so it's for demos only.
SPOTAFRIEND_APPSYNC_HTTP_DOMAIN=
SPOTAFRIEND_APPSYNC_REALTIME_DOMAIN=
SPOTAFRIEND_APPSYNC_API_KEY=


# ---- Spotify (planned, not used yet) ---------------------------------------
# For importing real playlists once the Spotify integration is built.
# Create an app at https://developer.spotify.com/dashboard (owner needs Premium).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
